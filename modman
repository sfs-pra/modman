_file_info_squashfs_detail() {
    local path="$1"
    local output=""
    local compression=""
    local level=""
    local line=""
    local lower=""

    command -v unsquashfs >/dev/null 2>&1 || return 1
    output=$(unsquashfs -s "$path" 2>/dev/null) || return 1
    printf '%s' "$output" | grep -qi 'squashfs' || return 1

    while IFS= read -r line; do
        line=${line//$'\t'/ }
        lower=${line,,}
        if [[ "$lower" == *compression*level* ]]; then
            level="${line##*[Ll]evel}"
            level="${level#:}"
        elif [[ "$lower" == compression[[:space:]]algorithm:* ]]; then
            compression="${line#*:}"
        elif [[ "$lower" == compression:* ]]; then
            compression="${line#*:}"
        elif [[ "$lower" == compression[[:space:]]* ]]; then
            compression="${line#*[Cc]ompression }"
        fi
        compression="${compression# }"
        level="${level# }"
    done <<< "$output"

    if [ -n "$compression" ] && [ -n "$level" ]; then
        printf 'squashfs %s %s\n' "$compression" "$level"
    elif [ -n "$compression" ]; then
        printf 'squashfs %s\n' "$compression"
    else
        printf 'squashfs\n'
    fi
}

_file_info_squashfs_list() {
    local path="$1"

    command -v unsquashfs >/dev/null 2>&1 || return 1
    unsquashfs -l -d "" "$path" 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            *squashfs-root/*)
                line=${line#*squashfs-root/}
                printf '%s\n' "$line"
                ;;
            *)
                printf '%s\n' "$line"
                ;;
        esac
    done
}

_file_info_modules() {
    local path="$1"
    local list=""
    local module=""
    local pfs_mount_new="${PFSDIR_MOUNT_NEW:-/var/lib/pfs/mount}"
    local pfs_mount_legacy="${PFSDIR_MOUNT_LEGACY:-/etc/packages/mount}"
    local pfs_mount_new_rel="${pfs_mount_new#/}"
    local pfs_mount_legacy_rel="${pfs_mount_legacy#/}"

    list=$(_file_info_squashfs_list "$path") || return 1
    while IFS= read -r module; do
        case "$module" in
            *"${pfs_mount_new}"/*/*/pfs.files|*"${pfs_mount_new_rel}"/*/*/pfs.files)
                case "$module" in
                    *"${pfs_mount_new}"/*/*/pfs.files)
                        module=${module#*${pfs_mount_new}/}
                        ;;
                    *)
                        module=${module#*${pfs_mount_new_rel}/}
                        ;;
                esac
                module=${module%/pfs.files}
                module=${module#*/}
                ;;
            *"${pfs_mount_legacy}"/*/pfs.files|*"${pfs_mount_legacy_rel}"/*/pfs.files)
                case "$module" in
                    *"${pfs_mount_legacy}"/*/pfs.files)
                        module=${module#*${pfs_mount_legacy}/}
                        ;;
                    *)
                        module=${module#*${pfs_mount_legacy_rel}/}
                        ;;
                esac
                module=${module%/pfs.files}
                ;;
            *)
                continue
                ;;
        esac
        [ -n "$module" ] && printf '%s\n' "$module"
    done <<< "$list" | sort -u | tr '\n' ' ' | sed 's/[[:space:]]*$//'
}

_file_info_cache_deps_for_module() {
    local module="$1"
    local shortname=""
    local deps=""

    [ -f "$CACHE_DEP" ] || return 0
    shortname=$(short_pkgname "$module")
    [ -n "$shortname" ] || return 0
    deps=$(grep -i "^$shortname :" "$CACHE_DEP" | head -n1 | cut -d':' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -n "$deps" ] || return 0
    printf '%s\n' $deps
}

_file_info_dependencies_from_modules() {
    local modules="$1"
    local fallback_name="$2"
    local module=""

    if [ -n "$modules" ]; then
        for module in $modules; do
            _file_info_cache_deps_for_module "$module"
        done
    else
        _file_info_cache_deps_for_module "$fallback_name"
    fi | sed '/^[[:space:]]*$/d' | sort -u | tr '\n' ' ' | sed 's/[[:space:]]*$//'
}

_file_info_erofs_detail() {
    local path="$1"
    local output=""
    local compression=""
    local line=""
    local lower=""

    command -v dump.erofs >/dev/null 2>&1 || return 1
    output=$(dump.erofs "$path" 2>&1) || return 1
    printf '%s' "$output" | grep -qi 'erofs' || return 1

    while IFS= read -r line; do
        line=${line//$'\t'/ }
        lower=${line,,}
        case "$lower" in
            compression:*)
                compression="${line#Compression:}"
                compression="${compression#compression:}"
                compression="${compression# }"
                ;;
            compression\ *)
                compression="${line#Compression }"
                compression="${compression#compression }"
                ;;
        esac
        [ -n "$compression" ] && break
    done <<< "$output"

    if [ -n "$compression" ]; then
        printf 'erofs %s\n' "$compression"
