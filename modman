}

remove_local() {
    if [ $# -eq 0 ]; then
        fatal_err "remove-local: не указаны модули для удаления"
        return 7
    fi

    _require_download_dir

    local had_invalid=0 had_mounted=0 had_other_fail=0

    local mounted_list=""
    if command -v "$PFSINFO_BIN" >/dev/null 2>&1; then
        mounted_list=$("$PFSINFO_BIN" --machine --mount 2>/dev/null || true)
    fi

    for raw_name in "$@"; do
        local name="${raw_name%."${EXT}"}"

        if ! [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]]; then
            printf 'error\tinvalid_name\t%s\n' "$raw_name"
            had_invalid=1
            continue
        fi

        local target="${DOWNLOAD_DIR}/${name}.${EXT}"
        if [ ! -e "$target" ]; then
            printf 'error\tnot_found\t%s\t%s\n' "$name" "$target"
            had_other_fail=1
            continue
        fi

        local target_resolved
        target_resolved=$(realpath -- "$target" 2>/dev/null || printf '%s' "$target")

        local is_mounted=0
        if [ -n "$mounted_list" ]; then
            while IFS=$'\t' read -r _mname _mlayer mpath _rest; do
                local mounted_source mounted_resolved
                [ -n "$mpath" ] || continue

                mounted_source=$(_resolve_source_path "$mpath")
                mounted_resolved=$(realpath -- "$mounted_source" 2>/dev/null || printf '%s' "$mounted_source")

                if [ "$mounted_resolved" = "$target_resolved" ]; then
                    is_mounted=1
                    break
                fi
            done <<< "$mounted_list"
        fi

        if [ "$is_mounted" -eq 1 ]; then
            printf 'error\tmounted\t%s\n' "$name"
            had_mounted=1
            continue
        fi

        if rm -f -- "$target"; then
            printf 'removed\t%s\t%s\n' "$name" "$target_resolved"
        else
            printf 'error\trm_failed\t%s\n' "$name"
            had_other_fail=1
        fi
    done

    if [ "$had_other_fail" -eq 1 ]; then
        return 9
    elif [ "$had_mounted" -eq 1 ]; then
        return 8
    elif [ "$had_invalid" -eq 1 ]; then
        return 7
    fi
    return 0
}

