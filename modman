    local layering_mode=""

    if grep -q ' / aufs' "$MODMAN_PROC_MOUNTS" 2>/dev/null; then
        _list_loaded_from_aufs "$filter" "" "" \
                | awk -F'\t' '!seen[$1 FS $3]++'
        return "${PIPESTATUS[0]}"
    fi

    initrd=$(detect_initrd) || return 1
    layering_mode=$(detect_layering_mode) || return 1

    if [ "$filter" != "all" ]; then
        if [ "$initrd" = "unknown" ]; then
            fatal_err "Не удалось определить initrd через pfs --detect-initrd; фильтр '$filter' недоступен."
            return 1
        fi
        _require_aufs_initrd_prefix
    fi

    if [ "$layering_mode" = "overlay" ]; then
