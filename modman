list_local() {
    local dirs=""
    local f=""
    local abs_path=""
    local name=""
    local size=""
    local date=""

    _require_download_dir
    dirs=$(_local_module_dirs | awk '!seen[$0]++')
    if [ "$MACHINE_MODE" -eq 1 ]; then
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            abs_path=$(realpath "$f" 2>/dev/null) || continue
            name=$(basename "$abs_path")
            size=$(du -h "$abs_path" | cut -f1)
            date=$(date -r "$abs_path" "+%Y-%m-%d")
            echo -e "${name}\t${size}\t${date}\t${abs_path}"
        done < <(
            while IFS= read -r dir; do
                [ -d "$dir" ] || continue
                find "$dir" -type f -name "*.${EXT}" -print 2>/dev/null
            done <<< "$dirs" | sort -u
        )
    else
        local found=0
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            abs_path=$(realpath "$f" 2>/dev/null) || continue
            ls -lh "$abs_path"
            found=1
        done < <(
            while IFS= read -r dir; do
                [ -d "$dir" ] || continue
                find "$dir" -type f -name "*.${EXT}" -print 2>/dev/null
            done <<< "$dirs" | sort -u
        )
        [ "$found" -eq 1 ] || print_msg "Нет скачанных файлов."
