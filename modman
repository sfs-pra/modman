download_file() {
    local filename="$1"
    local target="$DOWNLOAD_DIR/$filename"
    if [ -f "$target" ]; then
        print_msg "Файл $filename уже есть локально."
        return 0
    fi

    local repo_url
    local progress_file="${MODMAN_PROGRESS_FILE:-}"
    print_msg "Скачивание $filename..."
    while IFS= read -r repo_url; do
        [ -n "$repo_url" ] || continue
        if [ -n "$progress_file" ]; then
            # fs.protected_regular>=1 (Arch/Debian default) blocks open(O_CREAT|
            # O_TRUNC) on a regular file in a sticky world-writable dir like
            # /tmp when caller != file owner — even under root. The GUI creates
            # the sink as the unprivileged user before pkexec; we unlink first
            # so subsequent printf creates a fresh root-owned file in-place.
            rm -f -- "$progress_file" 2>/dev/null
            printf 'name=%s\nstage=download\npct=0\n' "$filename" > "$progress_file"
            wget --progress=dot:binary -O "$target" "$repo_url/$filename" 2>&1 | \
                awk -v PF="$progress_file" -v NM="$filename" '
                    /[0-9]+%/ {
                        if (match($0, /[0-9]+%/)) {
                            pct = substr($0, RSTART, RLENGTH - 1)
                            printf "name=%s\nstage=download\npct=%s\n", NM, pct > PF
                            close(PF)
                        }
                    }
                '
            local ec=${PIPESTATUS[0]}
            [ "$ec" -eq 0 ] && return 0
        elif [ "$MACHINE_MODE" -eq 1 ]; then
            wget -q -O "$target" "$repo_url/$filename" 2>/dev/null && return 0
        else
            wget --show-progress -O "$target" "$repo_url/$filename" 2>&1 && return 0
        fi
        rm -f "$target"
    done < <(iter_repos)
    print_err "Не удалось скачать $filename ни из одного репозитория."
    return 1
}

_install_local() {
    local pfs_path="$1"
    local abs_path basename shortname

    abs_path=$(realpath "$pfs_path" 2>/dev/null) || {
        print_err "Не удалось разрешить путь: $pfs_path"
        exit 1
    }
    [ -f "$abs_path" ] || {
        print_err "Файл не существует: $abs_path"
        exit 1
    }

    basename=$(basename "$abs_path")
    shortname=$(short_pkgname "$basename")

    if [ -f "$CACHE_DEP" ]; then
        local deps
        deps=$(grep "^$shortname :" "$CACHE_DEP" | cut -d':' -f2- | sed 's/^ *//')
        if [ -n "$deps" ]; then
            print_msg "Обнаружены зависимости для $basename: $deps"
            for dep in $deps; do
                _validate_name "$dep" || exit 2
                if _dep_is_satisfied "$dep"; then
                    print_msg "-> Зависимость '$dep' уже удовлетворена системой/локальными модулями"
                    continue
                fi
                _resolve_dep_or_abort "$basename" "$dep"
            done
        fi
    fi

    print_msg "Подключение $basename..."
    local load_rc
    if [ -n "$_PARSED_LOAD_CMD" ]; then
        # Custom command override: word-split the string into argv tokens.
        # NB: paths with spaces inside the override aren't supported.
        # shellcheck disable=SC2206
        _LOAD_CMD_ARGV=($_PARSED_LOAD_CMD)  # intentional unquoted expansion
        "${_LOAD_CMD_ARGV[@]}" "$abs_path"
        load_rc=$?
        if [ "$load_rc" -eq 0 ]; then
            print_ok "Модуль $basename успешно подключен."
            return 0
        fi
        print_err "Ошибка команды загрузки для $basename."
        return "$load_rc"
    elif command -v "$CMD_LOAD" >/dev/null 2>&1; then
        "$CMD_LOAD" "${_PARSED_PFSLOAD_FLAGS[@]}" "$abs_path"
        load_rc=$?
        if [ "$load_rc" -eq 0 ]; then
            print_ok "Модуль $basename успешно подключен."
            return 0
        fi
        print_err "Ошибка $CMD_LOAD для $basename."
        return "$load_rc"
    fi
    print_err "Команда $CMD_LOAD не найдена."
    return 127
}

install_module() {
    local name="$1"

    # Local file install: arg looks like a path AND points to an existing
    # .${EXT} file. Bypass cache lookup and use the file directly.
    case "$name" in
        */*|.*|"~"*)
            if [ -f "$name" ] && [ "${name##*.}" = "${EXT}" ]; then
                _install_local "$name"
                return $?
            fi
            ;;
    esac

    _validate_name "$name" || exit 2
    _require_download_dir
    local line
    line=$(_find_cache_line_by_shortname "$name" || true)

    if [ -z "$line" ] && [ "${MODMAN_EXACT_NAME:-0}" -ne 1 ]; then
        line=$(_find_cache_line_by_filename_match "$name" prefix || true)
    fi

    if [ -z "$line" ] && [ "${MODMAN_EXACT_NAME:-0}" -ne 1 ]; then
        line=$(_find_cache_line_by_filename_match "$name" contains || true)
    fi
    
    if [ -z "$line" ]; then
        print_err "Модуль '$name' не найден в базе."
        exit 1
    fi
    
    IFS=$'\t' read -r name size date desc _ <<< "$line"
    
    local shortname
    shortname=$(short_pkgname "$name")
    local deps=""
    if [ -f "$CACHE_DEP" ]; then
        deps=$(grep "^$shortname :" "$CACHE_DEP" | cut -d':' -f2- | sed 's/^ *//')
    fi
    
    if [ -n "$deps" ]; then
        print_msg "Обнаружены зависимости для $name: $deps"
        for dep in $deps; do
            _validate_name "$dep" || exit 2
            if _dep_is_satisfied "$dep"; then
                print_msg "-> Зависимость '$dep' уже удовлетворена системой/локальными модулями"
                continue
            fi
            _resolve_dep_or_abort "$name" "$dep"
        done
    fi
    
    if ! download_file "$name"; then
        print_err "Не удалось скачать $name"
        exit 1
    fi
    
    print_msg "Подключение $name..."
    local load_rc
    if [ -n "$_PARSED_LOAD_CMD" ]; then
        # Custom command override: word-split the string into argv tokens.
        # NB: paths with spaces inside the override aren't supported.
        # shellcheck disable=SC2206
        _LOAD_CMD_ARGV=($_PARSED_LOAD_CMD)  # intentional unquoted expansion
        "${_LOAD_CMD_ARGV[@]}" "$DOWNLOAD_DIR/$name"
        load_rc=$?
        if [ "$load_rc" -eq 0 ]; then
            print_ok "Модуль $name успешно подключен."
        else
            print_err "Ошибка команды загрузки для $name."
            exit "$load_rc"
        fi
    elif command -v "$CMD_LOAD" >/dev/null 2>&1; then
        "$CMD_LOAD" "${_PARSED_PFSLOAD_FLAGS[@]}" "$DOWNLOAD_DIR/$name"
        load_rc=$?
        if [ "$load_rc" -eq 0 ]; then
            print_ok "Модуль $name успешно подключен."
        else
            print_err "Ошибка pfsload для $name."
            exit "$load_rc"
        fi
    else
        print_err "Команда $CMD_LOAD не найдена."
        exit 127
    fi
}

remove_module() {
