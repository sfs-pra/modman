# Iterate active (non-commented) repository URLs in REPO_URLS order.
# Falls back to legacy single REPO_URL if REPO_URLS is empty.
iter_repos() {
    if [[ ${#REPO_URLS[@]} -gt 0 ]]; then
        for url in "${REPO_URLS[@]}"; do
            [[ "$url" =~ ^#.* ]] && continue
            [[ -n "$url" ]] && printf '%s\n' "$url"
        done
    elif [ -n "${REPO_URL:-}" ]; then
        printf '%s\n' "$REPO_URL"
    fi
}

# Backward-compat shim: first active URL only.
get_first_repo() {
    iter_repos | head -n 1
}

sync_db() {
    local repo_url merged_index merged_deps
    local any_index_ok=0 any_deps_ok=0
    local any_index_failed=0
    local repo_count=0

    merged_index="$(mktemp)"
    merged_deps="$(mktemp)"

    while IFS= read -r repo_url; do
        [ -n "$repo_url" ] || continue
        repo_count=$((repo_count + 1))
        local tmp_index tmp_deps
        tmp_index="$(mktemp)"
        tmp_deps="$(mktemp)"

        print_msg "Скачивание 000-index.txt с $repo_url..."
        if wget -qO "$tmp_index" "$repo_url/000-index.txt" && [ -s "$tmp_index" ]; then
            awk -v url="$repo_url" -v OFS='\t' 'NF > 0 {print $0, url}' "$tmp_index" >> "$merged_index"
            any_index_ok=1
            print_ok "  индекс: $(wc -l < "$tmp_index") записей"
        else
            print_err "  не удалось получить 000-index.txt"
            any_index_failed=1
        fi

        print_msg "Скачивание 000-dependencies.txt с $repo_url..."
        if wget -qO "$tmp_deps" "$repo_url/000-dependencies.txt" && [ -s "$tmp_deps" ]; then
            cat "$tmp_deps" >> "$merged_deps"
            any_deps_ok=1
            print_ok "  зависимости: $(wc -l < "$tmp_deps") записей"
        else
            print_msg "  000-dependencies.txt отсутствует (пропущен)"
        fi

        rm -f "$tmp_index" "$tmp_deps"
    done < <(iter_repos)

    if [ "$repo_count" -eq 0 ]; then
        print_err "REPO_URLS пуст, REPO_URL не задан — нечего синхронизировать."
        rm -f "$merged_index" "$merged_deps"
        exit 1
    fi

    if [ "$any_index_ok" -eq 0 ]; then
        rm -f "$merged_index" "$merged_deps"
        print_err "Не удалось получить 000-index.txt ни из одного репозитория."
        exit 1
    fi

    # Dedupe by filename (column 1, tab-separated). First occurrence wins:
    # earlier repos in REPO_URLS take precedence over later ones.
    awk -F'\t' '!seen[$1]++' "$merged_index" > "$CACHE_FILE"
    print_ok "Главный индекс: $(wc -l < "$CACHE_FILE") уникальных записей из $repo_count репо ($(wc -l < "$merged_index") всего)"

    if [ "$any_deps_ok" -eq 1 ]; then
        # Dedupe by shortname (everything before " : "). First occurrence wins.
        awk -F' : ' '!seen[$1]++' "$merged_deps" > "$CACHE_DEP"
        print_ok "Индекс зависимостей: $(wc -l < "$CACHE_DEP") уникальных записей"
    else
        : > "$CACHE_DEP"
        print_msg "Индекс зависимостей пуст — ни в одном репо нет 000-dependencies.txt."
    fi

    rm -f "$merged_index" "$merged_deps"

    if [ "$any_index_failed" -eq 1 ]; then
        print_err "Синхронизация завершена с ошибками: один или несколько репозиториев не отдали 000-index.txt."
        return 1
    fi
}

download_module() {
