        printf 'erofs\n'
    fi
}

query_file_info() {
    local path="$1"
    local ext="${EXT:-pfs}"

    if [ -z "$path" ]; then
        if [ "$MACHINE_MODE" -eq 1 ]; then
            printf 'error\t%s\n' "path required"
        else
            print_err "Usage: modman -Qp <path>"
        fi
        return 1
    fi

    if [ ! -f "$path" ]; then
        if [ "$MACHINE_MODE" -eq 1 ]; then
            printf 'error\t%s\n' "file not found: $path"
        else
            print_err "File not found: $path"
        fi
        return 1
    fi

    local realpath_val
    realpath_val=$(realpath "$path" 2>/dev/null) || realpath_val="$path"

    local basename_val
    basename_val=$(basename "$realpath_val")

    if [[ "$basename_val" != *."$ext" ]]; then
        if [ "$MACHINE_MODE" -eq 1 ]; then
            printf 'error\t%s\n' "not a .$ext file: $basename_val"
        else
            print_err "Not a .$ext file: $basename_val"
        fi
        return 1
    fi

    local name="${basename_val%.$ext}"

    local format="unknown"
    local format_detail=""
    local modules=""
    local dependencies=""
    local modules_human=""
    local dependencies_human=""
    local magic
    magic=$(dd if="$realpath_val" bs=4 count=1 2>/dev/null | od -A n -t x1 | tr -d ' \n') || true
    case "$magic" in
        73717368*) format="squashfs" ;;
        45324f73*|e2ro*|4532*) format="erofs" ;;
    esac

    if format_detail=$(_file_info_squashfs_detail "$realpath_val" 2>/dev/null); then
        format="squashfs"
    elif format_detail=$(_file_info_erofs_detail "$realpath_val" 2>/dev/null); then
        format="erofs"
    else
        format_detail=""
    fi

    format_detail=${format_detail//$'\t'/ }
    format_detail=${format_detail//$'\n'/ }

    modules=$(_file_info_modules "$realpath_val" 2>/dev/null || true)
    dependencies=$(_file_info_dependencies_from_modules "$modules" "$name" 2>/dev/null || true)
    modules=${modules//$'\t'/ }
    dependencies=${dependencies//$'\t'/ }
    modules=${modules//$'\n'/ }
    dependencies=${dependencies//$'\n'/ }
    modules_human=${modules// /$'\n'}
    dependencies_human=${dependencies// /$'\n'}

    local size
    size=$(du -h "$realpath_val" 2>/dev/null | cut -f1)
    [ -n "$size" ] || size="0"

    local loaded_state="local"
    if _find_mounted_by_pkgname "$name" >/dev/null 2>&1; then
        loaded_state="loaded"
    fi

    if [ "$MACHINE_MODE" -eq 1 ]; then
        printf 'file\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$realpath_val" "$name" "$format" "$loaded_state" "$size" "$format_detail" "$modules" "$dependencies"
    else
        print_msg "Файл:     $realpath_val"
        print_msg "Имя:      $name"
        print_msg "Формат:   $format"
        [ -n "$format_detail" ] && print_msg "FS:       $format_detail"
        print_msg "Размер:   $size"
        print_msg "Состояние: $loaded_state"
        if [ -n "$modules_human" ]; then
            print_msg "Модули:"
            while IFS= read -r module; do
                [ -n "$module" ] && print_msg "  $module"
            done <<< "$modules_human"
        else
            print_msg "Модули:   -----"
        fi
        if [ -n "$dependencies_human" ]; then
            print_msg "Зависимости:"
            while IFS= read -r dep; do
                [ -n "$dep" ] && print_msg "  $dep"
            done <<< "$dependencies_human"
        else
            print_msg "Зависимости: -----"
        fi
    fi
    return 0
}

open_config() {
    local conf="/etc/modman.conf"

    if ! command -v xdg-open >/dev/null 2>&1; then
        fatal_err "Команда xdg-open не найдена."
        return 1
    fi

    if [ "$(id -u)" = "0" ]; then
        xdg-open "$conf" >/dev/null 2>&1 &
        return 0
    fi

    xdg-open "admin://$conf" >/dev/null 2>&1 &
    return 0
}

