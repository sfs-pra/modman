# ПАРСИНГ АРГУМЕНТОВ
# ==========================================

print_help() {
    local style="${CLI_STYLE:-pacman}"
    cat <<EOF
modman — менеджер .${EXT} модулей PuppyRus / совместимых дистрибутивов.

Использование:
    modman [--machine] <команда> [аргументы]

EOF
    if [ "$style" = "apt" ]; then
        cat <<EOF
Команды (apt-style):
    update                    Синхронизировать локальный кэш индексов с зеркалами.
    search <имя>              Найти модули в индексах (подстрочный поиск).
    install <модуль>          Скачать .${EXT} и подключить (pfsload). Резолвит зависимости.
    download <модуль>         Скачать .${EXT} без подключения.
    remove <модуль>           Отключить загруженный модуль (pfsunload). Принимает короткое имя
                              (напр. "evince") — будет резолвлен в полное имя из списка mounted.
EOF
    else
        cat <<EOF
Команды (pacman-style):
    -Sy                       Синхронизировать локальный кэш индексов с зеркалами.
    -Ss <имя>                 Найти модули в индексах (подстрочный поиск).
    -S <модуль>               Скачать .${EXT} и подключить (pfsload). Резолвит зависимости
                              через 000-dependencies.txt; пропускает deps из MODMAN_IGNORE_DEPS.
    -D <модуль>               Скачать .${EXT} без подключения.
    -S <путь/файл.${EXT}>           Установить локальный .${EXT} файл по пути (без скачивания).
                              Принимается путь содержащий /, начинающийся с . или ~,
                              указывающий на существующий .${EXT} файл.
    -R <модуль>               Отключить загруженный модуль (pfsunload). Принимает короткое имя
                              (напр. "evince") — будет резолвлен в полное имя из списка mounted.
EOF
    fi
    cat <<EOF

Сервисные команды (общие для обоих стилей):
    -mi <dir>                 Сгенерировать 000-index.txt в каталоге <dir> (для мейнтейнера).
    -di <dir>                 Сгенерировать 000-dependencies.txt в каталоге <dir> (для мейнтейнера).
    --list-local              Показать локальные .${EXT}: DOWNLOAD_DIR, а для rootaufs2 также
                              base/modules/optional рядом с dir= из /proc/cmdline.
    --list-loaded             Показать все загруженные модули (источник: pfsinfo --machine --mount,
                              fallback: /sys/fs/aufs).
    --list-loaded-before      Показать только модули, загруженные initrd до старта системы.
    --list-loaded-after       Показать только модули, подключённые после старта системы.
    --check-updates           Проверить обновления для всех обнаруженных модулей (без изменений файлов).
    --update <id>             Применить одно обновление по id из --check-updates.
                              Системные модули (risk=system) требуют --confirm-system-updates.
                              Коды: 0 ок, 8 system без подтверждения, 1 ошибка.
    --update-all              Применить все доступные обновления.
                              Системные пропускаются (skipped/needs_confirmation) без --confirm-system-updates.
    --remove-local <имя...>   Удалить скачанные .${EXT} файлы из DOWNLOAD_DIR.
                              Вариативный: несколько имён через пробел. Принимает имя
                              или имя.${EXT}. Проверяет смонтированность — отклоняет.
                              Коды: 0 ок, 7 невалидное, 8 смонтирован, 9 другая ошибка.
    --list-old                Показать .${EXT}.old файлы в base/modules/optional rootaufs2.
    --remove-old <путь...>    Удалить выбранные .${EXT}.old файлы из base/modules/optional.
    -Qp <путь/файл.${EXT}>          Показать информацию о локальном .${EXT} файле.
    --file-info <путь>         То же, что -Qp.
    --open-config             Открыть /etc/modman.conf через xdg-open.
    -h, --help                Показать эту справку.

Короткие псевдонимы:
    -L                        Эквивалент --list-loaded
    -Lb                       Эквивалент --list-loaded-before
    -La                       Эквивалент --list-loaded-after
    -Ql                       Эквивалент --list-local
    -Rl <имя...>              Эквивалент --remove-local

Глобальные опции:
    --machine                 Машинный вывод (TSV). Подавляет цветной/человеческий текст.
    --confirm-system-updates  Разрешить обновление системных модулей (risk=system).
                              Без этого флага --update и --update-all пропускают их (exit 8).
    -d, --download-dir DIR    Override DOWNLOAD_DIR на эту команду (поверх config + autodetect).
                              Полезно если автоопределённый каталог read-only.
    --force-deps              Не прерывать установку при провале установки зависимости.
                              По умолчанию любая failed dep → abort parent install.
                              НЕБЕЗОПАСНО — модуль может не работать без зависимостей.
    --progress-file PATH      Писать машинно-читаемый прогресс скачивания в файл.
                              Эквивалент env MODMAN_PROGRESS_FILE, но переживает pkexec.
                              Формат строк: name=<имя>\\nstage=download\\npct=<0..100>\\n.
                              Используется GUI для отображения прогресс-бара.
    --lower                   Подключить модуль в нижний слой AUFS (передаёт pfsload -l).
    --upper                   Подключить модуль в верхний слой AUFS (передаёт pfsload -u).
    --toram                   Скопировать модуль в tmpfs и подключить (передаёт pfsload -r).
    --load-cmd="CMD"          Заменить CMD_LOAD целиком. Команда разбивается по пробелам
                              (word-splitting). Пути с пробелами в команде не поддерживаются.
                              Пример: --load-cmd="pfsramload -l".

Конфигурация: /etc/modman.conf (см. man modman.conf).
    DOWNLOAD_DIR              Каталог скачивания .${EXT}.
    CACHE_DIR                 Каталог кэша (db.txt + dependencies.txt внутри).
                              Legacy CACHE_FILE=/path/to/db.txt тоже принимается.
    MODMAN_IGNORE_DEPS        Glob-паттерны deps, которые пропускать (см. modman.conf).
    AUFS_INITRD_PREFIX        Префикс путей base-модулей (per-initrd).
    EXT                       Расширение файлов модулей (по умолчанию: pfs).

Примеры:
    modman --machine -Ss browser     # машинный поиск
    sudo modman -S evince            # установка с резолвом deps
    sudo modman -R evince            # удаление по короткому имени
    modman --list-loaded-before      # модули из initrd
EOF
}

CMD="$1"
ARG="$2"

case "$CMD" in
    -h|--help|help) print_help; exit 0 ;;
    "") print_help; exit 0 ;;
esac

mkdir -p "$DOWNLOAD_DIR" 2>/dev/null || true
mkdir -p "$(dirname "$CACHE_FILE")" 2>/dev/null || true

if [ "$CLI_STYLE" == "pacman" ]; then
    case "$CMD" in
        -mi) make_index "$ARG" ;;
        -di) make_deps "$ARG" ;;
        -Sy) sync_db ;;
        -Ss) search_module "$ARG" ;;
        -S)  install_module "$ARG" ;;
        -D|--download) download_module "$ARG" ;;
        -R)  remove_module "$ARG" ;;
        --list-local|-Ql) list_local ;;
        --list-loaded|-L) list_loaded "$ARG" ;;
        --list-loaded-before|-Lb) list_loaded "before" ;;
        --list-loaded-after|-La) list_loaded "after" ;;
        --check-updates) check_updates ;;
        --update) apply_update "$ARG"; exit $? ;;
        --update-all) update_all; exit $? ;;
        --update-blacklist-list) update_blacklist_list ;;
        --update-blacklist-add) update_blacklist_add "$ARG" ;;
        --update-blacklist-remove) shift; update_blacklist_remove "$@"; exit $? ;;
        --remove-local|-Rl) shift; remove_local "$@"; exit $? ;;
        --list-old) list_old_modules ;;
        --remove-old) shift; remove_old_modules "$@"; exit $? ;;
        -Qp|--file-info) query_file_info "$ARG"; exit $? ;;
        --open-config) open_config ;;
        --deps) list_module_deps "$ARG" ;;
        *) print_help >&2; exit 1 ;;
    esac
elif [ "$CLI_STYLE" == "apt" ]; then
    case "$CMD" in
        -mi) make_index "$ARG" ;;
        -di) make_deps "$ARG" ;;
        update) sync_db ;;
        search) search_module "$ARG" ;;
        install) install_module "$ARG" ;;
        download) download_module "$ARG" ;;
        remove) remove_module "$ARG" ;;
        --list-local|-Ql) list_local ;;
        --list-loaded|-L) list_loaded "$ARG" ;;
        --list-loaded-before|-Lb) list_loaded "before" ;;
        --list-loaded-after|-La) list_loaded "after" ;;
        --check-updates) check_updates ;;
        --update) apply_update "$ARG"; exit $? ;;
        --update-all) update_all; exit $? ;;
        --update-blacklist-list) update_blacklist_list ;;
        --update-blacklist-add) update_blacklist_add "$ARG" ;;
        --update-blacklist-remove) shift; update_blacklist_remove "$@"; exit $? ;;
        --remove-local|-Rl) shift; remove_local "$@"; exit $? ;;
        --list-old) list_old_modules ;;
        --remove-old) shift; remove_old_modules "$@"; exit $? ;;
        -Qp|--file-info) query_file_info "$ARG"; exit $? ;;
        --open-config) open_config ;;
        --deps) list_module_deps "$ARG" ;;
        *) print_help >&2; exit 1 ;;
    esac
fi
