    if resolved=$(_find_mounted_by_pkgname "$pkg" 2>/dev/null); then
        if [ -n "$resolved" ] && [ "$resolved" != "$pkg" ]; then
            print_msg "Найден загруженный модуль: $resolved"
            pkg="$resolved"
        fi
    fi

    print_msg "Отключение $pkg..."
    if command -v "$CMD_UNLOAD" >/dev/null 2>&1; then
        "$CMD_UNLOAD" "$pkg"
        local ret=$?
        if [ $ret -eq 0 ]; then
            print_ok "Модуль $pkg отключен."
        else
            print_err "Ошибка pfsunload для $pkg."
