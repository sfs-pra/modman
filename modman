# ГЕНЕРАЦИЯ ИНДЕКСОВ (ДЛЯ МЕЙНТЕЙНЕРА)
# ==========================================

make_index() {
    local target_dir="${1:-.}"
    if [ ! -d "$target_dir" ]; then
        print_err "Директория $target_dir не существует!"
        exit 1
    fi
    
    local index_file="$target_dir/000-index.txt"
    local tmp_index="$target_dir/000-index.txt.tmp"
    : > "$tmp_index"
    
    declare -A cache_size cache_date cache_desc
    if [ -f "$index_file" ]; then
        print_msg "Найден старый индекс. Создание бэкапа..."
        cp "$index_file" "${index_file}.bak"
        while IFS=$'\t' read -r name size date desc deps; do
            cache_size["$name"]="$size"
            cache_date["$name"]="$date"
            cache_desc["$name"]="$desc"
        done < "$index_file"
    fi
    
    local files=("$target_dir"/*."${EXT}")
    local total=${#files[@]}
    local count=0
    
    print_msg "Генерация главного индекса ($total файлов)..."
    
    for pfs in "${files[@]}"; do
        [ -e "$pfs" ] || continue
        ((count++))
        local filename
        local size
        local date
        filename=$(basename "$pfs")
        size=$(du -h "$pfs" | cut -f1)
        date=$(date -r "$pfs" "+%Y-%m-%d")
        
        printf "[%3d/%3d] %-40s " "$count" "$total" "${filename:0:40}"
        
        local desc=""
        if [ "${cache_size[$filename]}" == "$size" ] && [ "${cache_date[$filename]}" == "$date" ] && [ -n "${cache_desc[$filename]}" ]; then
            desc="${cache_desc[$filename]}"
            printf "\e[32m[КЭШ]\e[0m\n"
        else
            local pkgname
            pkgname=$(clean_pkgname "$filename")
            if command -v pacman >/dev/null 2>&1; then
                # Используем LC_ALL=C для получения Description на английском
                desc=$(LC_ALL=C pacman -Si "$pkgname" 2>/dev/null | grep -i "^Description" | cut -d':' -f2- | sed 's/^ *//')
                
                if [ -z "$desc" ]; then
                    # Фолбэк: широкий поиск (если точное имя не найдено)
                    desc=$(LC_ALL=C pacman -Ss "$pkgname" 2>/dev/null | grep -A 1 "^.*/$pkgname " | tail -n 1 | sed 's/^ *//')
                fi
                
                if [ -z "$desc" ] && command -v curl >/dev/null 2>&1; then
                    # Фолбэк AUR: Прямой запрос к API Arch User Repository
                    desc=$(curl -s "https://aur.archlinux.org/rpc/?v=5&type=search&arg=$pkgname" | grep -o '"Description":"[^"]*"' | head -n1 | cut -d'"' -f4)
                fi
            elif command -v apt-cache >/dev/null 2>&1; then
                desc=$(LC_ALL=C apt-cache show "$pkgname" 2>/dev/null | grep -i "^Description:" | head -n1 | cut -d':' -f2- | sed 's/^ *//')
                if [ -z "$desc" ]; then
                    # Фолбэк для APT: поиск по подстроке
                    desc=$(LC_ALL=C apt-cache search "^$pkgname" 2>/dev/null | head -n1 | grep -oE ' - .*' | sed 's/^ - //')
                fi
            fi
            
            [ -z "$desc" ] && desc="Нет описания"
            printf "\e[33m[ОБНОВЛЕН]\e[0m (%s)\n" "$pkgname"
        fi
        
        echo -e "${filename}\t${size}\t${date}\t${desc}\t-" >> "$tmp_index"
    done
    mv "$tmp_index" "$index_file"
    print_ok "Индекс $index_file успешно обновлен."
}

make_deps() {
    local target_dir="${1:-.}"
    if [ ! -d "$target_dir" ]; then
        print_err "Директория $target_dir не существует!"
        exit 1
    fi
    
    local deps_file="$target_dir/000-dependencies.txt"
    local tmp_deps="$target_dir/000-dependencies.txt.tmp"
    : > "$tmp_deps"
    
    declare -A cache_deps
    if [ -f "$deps_file" ]; then
        print_msg "Найден старый файл зависимостей. Создание бэкапа..."
        cp "$deps_file" "${deps_file}.bak"
        local deps_file_mtime
        deps_file_mtime=$(stat -c %Y "$deps_file")
        while read -r line; do
            if [[ "$line" =~ ^(.*)\ :\ (.*)$ ]]; then
                local f="${BASH_REMATCH[1]}"
                f="${f// /}"
                cache_deps["$f"]="${BASH_REMATCH[2]}"
            fi
        done < "$deps_file"
    else
        local deps_file_mtime=0
    fi
    
    local files=("$target_dir"/*."${EXT}")
    local total=${#files[@]}
    local count=0
    
    print_msg "Извлечение зависимостей ($total файлов)..."
    
    for pfs in "${files[@]}"; do
        [ -e "$pfs" ] || continue
        ((count++))
        local filename
        local shortname
        local file_mtime
        filename=$(basename "$pfs")
        shortname=$(short_pkgname "$filename")
        file_mtime=$(stat -c %Y "$pfs")
        
        printf "[%3d/%3d] %-40s " "$count" "$total" "${shortname:0:40}"
        
        local deps=""
        if [ "$file_mtime" -lt "$deps_file_mtime" ]; then
            deps="${cache_deps[$shortname]}"
            if [ -n "$deps" ]; then
                printf "\e[32m[КЭШ]\e[0m (%s)\n" "$deps"
            else
                printf "\e[32m[КЭШ]\e[0m (пусто)\n"
            fi
        else
            if command -v unsquashfs >/dev/null 2>&1; then
                # Строго извлекаем только имена пакетов после <pkg>-dep, игнорируя кавычки, команды и bash-шум
                deps=$(unsquashfs -cat "$pfs" start.sh 2>/dev/null | grep -oE '[a-zA-Z0-9_-]+-dep [ A-Za-z0-9_-]+' | sed 's/^[a-zA-Z0-9_-]*-dep //')
            fi
            if [ -n "$deps" ]; then
                printf "\e[33m[НАЙДЕНЫ]\e[0m (%s)\n" "$deps"
            else
                printf "\e[90m[ПУСТО]\e[0m\n"
            fi
        fi
        
        if [ -n "$deps" ]; then
            echo "$shortname : $deps" >> "$tmp_deps"
        fi
    done
    mv "$tmp_deps" "$deps_file"
    print_ok "Файл зависимостей $deps_file успешно обновлен."
}

