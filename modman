    [[ "$file_path" == *".${EXT}.old" ]] || return 1
    case "$file_path" in
        "$cleanup_root"/base/*|"$cleanup_root"/modules/*|"$cleanup_root"/optional/*)
            return 0
            ;;
    esac
    return 1
}

